rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /listings/{ownerUid}/{listingId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(ownerUid) && isAllowedImage();
      allow update: if false;
      allow delete: if isOwner(ownerUid) || isAdmin();
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid) && isAllowedImage();
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
