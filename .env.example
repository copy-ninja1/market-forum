# Firebase web app configuration (safe to expose in client apps)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: connect the web app to Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Application defaults
VITE_DEFAULT_CURRENCY_CODE=USD
VITE_APP_NAME=Student Market Forum

# Public site origin for canonical URLs, Open Graph, and sitemaps (no trailing slash)
# Also set PUBLIC_SITE_URL on Cloud Functions for SSR/sitemap absolute URLs
VITE_PUBLIC_SITE_URL=https://your-project-id.web.app
